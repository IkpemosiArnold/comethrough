{
  "name": "comethrough",
  "version": "0.1.0",
  "description": "The lazy crew organiser. Plans arrive by flyer, link or one sentence; your crew taps once; rides and reminders sort themselves. Open models (Gemma) and open data (OpenStreetMap, Open-Meteo).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node src/server/server.mjs",
    "start": "node src/server/server.mjs",
    "test": "node --test test/*.test.mjs eval/test/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "mongodb": "^7.7.0",
    "satori": "^0.63.2",
    "web-push": "^3.6.7"
  }
}
