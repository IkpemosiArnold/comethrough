{
  "name": "Come Through",
  "short_name": "Come Through",
  "description": "The lazy way to link up. You send one sentence, your crew taps once.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f1e7",
  "theme_color": "#f6f1e7",
  "lang": "en-NG",
  "categories": ["social", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "image", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp"] }]
    }
  },
  "shortcuts": [
    { "name": "Add a plan", "url": "/?go=add", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
