# Copy to .env for local runs. Every variable is optional unless marked.

# Server
PORT=3000
# where this API is reachable (calendar links are built from it)
PUBLIC_URL=http://localhost:3000
# where the web app is served (invite links point there; defaults to PUBLIC_URL, since this
# server also serves web/dist); when it differs, it is the only CORS origin allowed
# WEB_URL=http://localhost:5173
# extra allowed origins, comma separated (defaults to WEB_URL)
# WEB_ORIGIN=
# proxies that append to X-Forwarded-For: 3 on Render behind Cloudflare, 0 locally
# TRUST_PROXY_HOPS=0
# required for POST /api/tick (the scheduler's heartbeat)
TICK_SECRET=change-me

# Data: MongoDB Atlas when MONGODB_URI is set, else JSON files under DATA_DIR
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB=comethrough
# DATA_DIR=.data

# Gemma through the Gemini API (aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_FALLBACKS=gemma-4-31b-it
# GEMMA_VISION_MODEL=
# GEMMA_TIMEOUT_MS=25000

# Open data (defaults are the public endpoints; please respect their usage policies)
# photon (default; also serves type-ahead) or nominatim
# GEOCODER=photon
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# PHOTON_URL=https://photon.komoot.io
# comma-separated: each is tried in turn when the one before is at capacity or slow
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# a URL or email for the User-Agent sent to OpenStreetMap services
# CONTACT=

# Web Push (generate once: npx web-push generate-vapid-keys). Without keys, push is off.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@comethrough.tech

# The built web app is served from here when the folder exists
# STATIC_DIR=web/dist

# OFFLINE=1 runs with fakes for every outside service (UI work with no keys or network)
# OFFLINE=1

# Links
# UID_DOMAIN=comethrough.tech
# looking (m.uber.com/looking, default) or legacy (m.uber.com/ul)
# UBER_LINK_STYLE=looking
# IMAGE_MAX_BYTES=5242880
