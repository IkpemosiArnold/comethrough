# Copy to .env for local runs. Every variable is optional unless marked.

# Server
PORT=8790
# where this API is reachable (calendar links are built from it)
PUBLIC_URL=http://localhost:8790
# where the web app is served (invite links point there); also the only CORS origin allowed
WEB_URL=http://localhost:5173
# extra allowed origins, comma separated (defaults to WEB_URL)
# WEB_ORIGIN=
# proxies that append to X-Forwarded-For: 3 on Render behind Cloudflare, 0 locally
# TRUST_PROXY_HOPS=0
# required for POST /api/tick (the scheduler's heartbeat)
TICK_SECRET=change-me

# Data: MongoDB Atlas when MONGODB_URI is set, else JSON files under DATA_DIR
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB=comethrough
# DATA_DIR=.data

# Gemma through the Gemini API (aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_FALLBACKS=gemma-4-31b-it
# GEMMA_VISION_MODEL=
# GEMMA_TIMEOUT_MS=25000

# Open data (defaults are the public endpoints; please respect their usage policies)
# photon (default; also serves type-ahead) or nominatim
# GEOCODER=photon
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# PHOTON_URL=https://photon.komoot.io
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# a URL or email for the User-Agent sent to OpenStreetMap services
# CONTACT=

# Links
# UID_DOMAIN=comethrough.tech
# looking (m.uber.com/looking, default) or legacy (m.uber.com/ul)
# UBER_LINK_STYLE=looking
# IMAGE_MAX_BYTES=5242880
